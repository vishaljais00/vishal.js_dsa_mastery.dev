# ==========================================
# JS DSA Mastery Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ==========================================

# Express Server Port
PORT=3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=js_dsa_db

# Redis Caching Configuration (Optional: falls back to in-memory TTL cache if offline)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email SMTP Configuration (Optional: falls back to Ethereal/console test mode if empty)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
