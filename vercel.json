{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend-app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend-app/dist/js-dsa-frontend/browser"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/health",
      "dest": "/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend-app/dist/js-dsa-frontend/browser/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend-app/dist/js-dsa-frontend/browser/index.html"
    }
  ]
}
